  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "types": ["node"],
    "outDir": "dist", "rootDir": ".", "sourceMap": true,
