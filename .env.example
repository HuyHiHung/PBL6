# Copy to .env. Local scripts discover the local Supabase keys without printing them.
# Never place service credentials in a frontend VITE_* variable.
# backend:start supplies a different DATABASE_URL to each service from .local/runtime.json.
# Do not run business APIs with the postgres owner account.
SUPABASE_URL=http://127.0.0.1:54321
# Set separately in the environment when Google OAuth is configured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
